# Copy to .env and fill in ONE of the keys. Never commit .env.
VOCAREUM_API_KEY=        # Udacity workspace key (uses https://openai.vocareum.com/v1)
# OPENAI_API_KEY=        # or a regular OpenAI key

# Optional settings
# UDAHUB_MODEL=gpt-4o-mini
# UDAHUB_EMBEDDINGS=openai            # hybrid RAG: TF-IDF + OpenAI embeddings
# UDAHUB_MCP_TRANSPORT=memory         # memory (default) | stdio
# UDAHUB_DB_PATH=/abs/path/udahub.db  # override DB / log locations
# CULTPASS_DB_PATH=/abs/path/cultpass.db
# UDAHUB_LOG_PATH=/abs/path/agent_events.jsonl
